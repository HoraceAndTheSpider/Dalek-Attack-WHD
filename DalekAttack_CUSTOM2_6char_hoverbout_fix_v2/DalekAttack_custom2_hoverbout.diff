@@ -272,11 +294,41 @@
 .badPortrait	lea	BadPortrait6Message(pc),a0
 		bra	AbortAssetError
 
+.badHoverbout	lea	BadHoverbout6Message(pc),a0
+		bra	AbortAssetError
+
 AbortAssetError
 		move.l	a0,-(sp)
 		pea	TDREASON_FAILMSG
 		move.l	(_resload,pc),a2
 		jmp	(resload_Abort,a2)
+
+; ---------------------------------------------------------------------------
+; Level 1 sixth hoverbout frame
+; ---------------------------------------------------------------------------
+; SPRITES1 descriptor 21:
+;   width 32, height 56, frames 6, bytes/frame $380
+;   descriptor data begins at SPRITES1 bank offset $A500
+;   frame 5 begins at $A500 + (5*$380) = $B680
+;
+; Original frames 0..4 are CHAR1..CHAR5 on the hoverbout.
+; Original frame 5 is the empty hoverbout, which is why CHAR6 currently
+; appears without its rider. The selector already chooses frame 5 correctly.
+DecrunchLevelSprites
+		jsr	$d74c			; original Ice depacker
+		movem.l	d0-d1/a0-a2,-(sp)
+		tst.w	$8a(a5)		; 0 = Level 1 / SPRITES1
+		bne.b	.done
+
+		movea.l	#HOVERBOUT6_CHIP,a0
+		movea.l	$55f8,a1
+		adda.l	#LEVEL1_HOVERBOUT6_OFFSET,a1
+		move.w	#(HOVERBOUT_SIZE/4)-1,d0
+.copy		move.l	(a0)+,(a1)+
+		dbf	d0,.copy
+
+.done		movem.l	(sp)+,d0-d1/a0-a2
+		rts
 
